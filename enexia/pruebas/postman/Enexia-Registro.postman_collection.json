    {
      "name": "06 - Cuerpo vacio: validacion por campo (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('400 Bad Request', function () { pm.response.to.have.status(400); });",
              "",
              "const cuerpo = pm.response.json();",
              "pm.test('Codigo VALIDACION_FALLIDA', function () {",
              "    pm.expect(cuerpo.error).to.eql('VALIDACION_FALLIDA');",
              "});",
              "",
              "// El frontend pinta cada input a partir de este mapa, por eso la",
              "// clave tiene que coincidir con el nombre del campo del DTO.",
              "pm.test('Detalla el motivo de cada campo obligatorio', function () {",
              "    ['email','nickname','password','nombre','apellido','dni','fechaNacimiento','perfil']",
              "        .forEach(function (campo) {",
              "            pm.expect(cuerpo.errores, 'falta ' + campo).to.have.property(campo);",
              "        });",
              "});"
            ]
          }
        }
      ],
      "request": {
