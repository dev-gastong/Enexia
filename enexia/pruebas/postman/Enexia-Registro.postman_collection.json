    {
      "name": "13 - Moderacion de texto: nickname ofensivo (422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('422 Unprocessable Content', function () { pm.response.to.have.status(422); });",
              "",
              "pm.test('Codigo CONTENIDO_INAPROPIADO', function () {",
              "    pm.expect(pm.response.json().error).to.eql('CONTENIDO_INAPROPIADO');",
              "});",
              "",
              "// El paso 1.1.1A corre ANTES de escribir. Si corriera despues, el",
              "// texto ofensivo quedaria en la base aunque el alta se rechace.",
              "pm.test('No devuelve id: no se persistio nada', function () {",
              "    pm.expect(pm.response.json()).to.not.have.property('idUsuario');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"moderado.{{sufijo}}@enexia.test\",\n  \"nickname\": \"pelotudo_{{sufijo}}\",\n  \"password\": \"Segura123\",\n  \"passwordConfirmacion\": \"Segura123\",\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Lopez\",\n  \"dni\": \"29888785\",\n  \"fechaNacimiento\": \"1995-03-20\",\n  \"perfil\": \"PARTICIPANTE\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/registro", "host": ["{{baseUrl}}"], "path": ["api", "auth", "registro"] },
        "description": "Paso 1.1.1A contra src/main/resources/moderacion/terminos-bloqueados.txt."
      }
    },

    {
      "name": "14 - Moderacion: evasion con l33t speak (422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// El normalizador deshace la sustitucion de caracteres antes de",
              "// comparar, asi que cambiar letras por numeros no alcanza para pasar.",
              "pm.test('422 Unprocessable Content', function () { pm.response.to.have.status(422); });",
              "pm.test('Codigo CONTENIDO_INAPROPIADO', function () {",
              "    pm.expect(pm.response.json().error).to.eql('CONTENIDO_INAPROPIADO');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"leet.{{sufijo}}@enexia.test\",\n  \"nickname\": \"b0lud0\",\n  \"password\": \"Segura123\",\n  \"passwordConfirmacion\": \"Segura123\",\n  \"nombre\": \"Ana\",\n  \"apellido\": \"Lopez\",\n  \"dni\": \"29888786\",\n  \"fechaNacimiento\": \"1995-03-20\",\n  \"perfil\": \"PARTICIPANTE\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/registro", "host": ["{{baseUrl}}"], "path": ["api", "auth", "registro"] }
      }
    },

    {
      "name": "15 - La cuenta creada puede iniciar sesion (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Cierre del circuito: comprueba que el hash BCrypt guardado en el",
              "// alta es el que despues valida el login. Si el registro guardara la",
              "// clave en claro o con otro algoritmo, esta prueba fallaria.",
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "",
              "const cuerpo = pm.response.json();",
              "",
              "pm.test('Emite un JWT', function () {",
              "    pm.expect(cuerpo.token).to.be.a('string');",
              "    pm.expect(cuerpo.token.split('.')).to.have.lengthOf(3);",
              "    pm.expect(cuerpo.tipoToken).to.eql('Bearer');",
              "});",
              "",
              "pm.test('El token lleva los roles del alta', function () {",
              "    pm.expect(cuerpo.roles).to.eql(['PARTICIPANTE']);",
              "});",
              "",
              "pm.collectionVariables.set('token', cuerpo.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{emailUnico}}\",\n  \"password\": \"Segura123\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      }
    },

    {
      "name": "16 - El token del alta sirve en /me (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
              "pm.test('Identifica al usuario recien registrado', function () {",
              "    pm.expect(pm.response.json().email).to.eql(pm.collectionVariables.get('emailUnico').toLowerCase());",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] },
        "description": "Verifica que el alta produjo una identidad utilizable en endpoints protegidos."
      }
    }
  ]
