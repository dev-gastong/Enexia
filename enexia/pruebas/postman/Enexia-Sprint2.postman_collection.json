              "const c = pm.response.json();",
              "",
              "pm.test('La CUENTA nace ACTIVA y usable', function () {",
              "    // El estado de revision es de la ORGANIZACION, no del usuario.",
              "    // Si recayera sobre la cuenta, el fundador no podria ni entrar.",
              "    pm.expect(c.cuenta.estado).to.eql('ACTIVO');",
              "});",
              "",
              "pm.test('El ORGANIZADOR recibe tambien el rol PARTICIPANTE', function () {",
              "    pm.expect(c.cuenta.roles).to.include('ORGANIZADOR');",
              "    pm.expect(c.cuenta.roles).to.include('PARTICIPANTE');",
              "});",
              "",
              "pm.test('La ORGANIZACION nace APROBADA + ACTIVA (ADR-14)', function () {",
              "    pm.expect(c.organizacion.estadoSistema).to.eql('APROBADO');",
              "    pm.expect(c.organizacion.estado).to.eql('ACTIVO');",
              "});",
              "",
              "pm.test('El fundador queda como ADMINISTRADOR', function () {",
              "    pm.expect(c.organizacion.rolEnEmpresa).to.eql('ADMINISTRADOR');",
